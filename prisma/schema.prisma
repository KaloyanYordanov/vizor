generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-Tenant ───────────────────────────────────────────

model Company {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logo      String?
  website   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  users     User[]

  @@map("companies")
}

// ─── Auth ───────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── Project / Building / Floor / Apartment ─────────────────

model Project {
  id              String     @id @default(uuid())
  name            String
  slug            String
  description     String?
  address         String?
  coverImage      String?
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  buildings       Building[]
  // IREPlugin-style settings
  currencySymbol  String     @default("€")
  areaUnit        String     @default("m²")
  primaryColor    String     @default("#3b82f6")
  availableColor  String     @default("#22c55e")
  reservedColor   String     @default("#f59e0b")
  soldColor       String     @default("#ef4444")
  unavailableColor String    @default("#9ca3af")
  strokeColor     String     @default("#1e293b")
  strokeWidth     Float      @default(2)
  tooltipStyle    String     @default("modern")
  tooltipShape    String     @default("rounded")
  embedConfig     Json?      // Full embed configuration (EmbedConfig JSON)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([companyId, slug])
  @@map("projects")
}

model Building {
  id                String   @id @default(uuid())
  name              String
  slug              String
  description       String?
  svgContent        String?  @db.Text // The full SVG markup for building exterior
  imageUrl          String?           // Optional raster image for building facade
  floorsPolygonData Json?             // Array of { floorNumber, points: [{x,y}] } polygon-to-floor mappings
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors            Floor[]
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, slug])
  @@map("buildings")
}

enum FloorType {
  APARTMENT
  GARAGE
  COMMERCIAL
}

model Floor {
  id          String      @id @default(uuid())
  number      Int
  label       String?     // e.g. "Ground Floor", "Penthouse"
  type        FloorType   @default(APARTMENT)
  svgContent  String?     @db.Text // SVG markup for this floor plan
  imageUrl    String?
  buildingId  String
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartments  Apartment[]
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([buildingId, number])
  @@map("floors")
}

enum ApartmentStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNAVAILABLE
}

model Apartment {
  id            String          @id @default(uuid())
  number        String          // e.g. "A-101"
  rooms         Float           // e.g. 2.5
  area          Float           // square meters
  price         Float?
  pricePerSqm   Float?
  status        ApartmentStatus @default(AVAILABLE)
  svgPathId     String?         // CSS selector / ID inside floor SVG
  polygonData   Json?           // Array of {x, y} normalized coords for drawn polygon
  description   String?
  features      String?         // JSON string of features
  floorId       String
  floor         Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  floorPlanUrl  String?         // individual apartment floor plan image
  visualisationPlan VisualisationPlan?
  visualisationBatches VisualisationBatch[]
  visualisationPublication ApartmentVisualisationPublication?
  images        ApartmentImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([floorId, number])
  @@map("apartments")
}

model ApartmentImage {
  id          String    @id @default(uuid())
  url         String
  caption     String?
  sortOrder   Int       @default(0)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("apartment_images")
}

// Private visualisation data is served only by the dedicated scoped routes.
model VisualisationPlan {
  id          String              @id @default(uuid())
  apartmentId String              @unique
  apartment   Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  fingerprint String
  imageKey    String
  width       Int
  height      Int
  revision    Int                 @default(1)
  rooms       VisualisationRoom[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// Legacy room records retained for historical data only; new jobs are apartment-scoped.
model VisualisationRoom {
  id          String                    @id @default(uuid())
  planId      String
  plan        VisualisationPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  label       String
  type        String
  region      Json
  revision    Int                       @default(1)
  archived    Boolean                   @default(false)
  jobs        VisualisationJob[]
  publication VisualisationPublication?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([planId, archived])
}

model VisualisationBatch {
  id              String             @id @default(uuid())
  apartmentId     String
  apartment       Apartment          @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  companyId       String
  createdById     String
  clientRequestId String
  requestHash     String
  styleId         String
  settings        Json
  retryOfId       String?
  jobs            VisualisationJob[]
  createdAt       DateTime           @default(now())

  @@unique([apartmentId, clientRequestId])
  @@index([companyId, createdAt])
}

enum VisualisationJobState {
  QUEUED
  PREPARING
  GENERATING
  SAVING
  SUCCEEDED
  FAILED
  SUPERSEDED
}

// The job table is itself a durable Postgres queue, claimed with SKIP LOCKED.
model VisualisationJob {
  id                   String                             @id @default(uuid())
  batchId              String
  batch                VisualisationBatch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  roomId               String?
  room                 VisualisationRoom?                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind                 String                             @default("IMAGE")
  state                VisualisationJobState              @default(QUEUED)
  input                Json
  result               Json?
  outputKey            String?
  thumbnailKey         String?
  width                Int?
  height               Int?
  errorCode            String?
  providerRequestId    String?
  claimToken           String?
  leaseUntil           DateTime?
  submittedAt          DateTime?
  finishedAt           DateTime?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
  publication          VisualisationPublication?
  apartmentPublication ApartmentVisualisationPublication?

  @@unique([batchId, roomId])
  @@index([state, createdAt])
}

// Legacy publication records retained for old URLs and migration history.
model VisualisationPublication {
  roomId        String            @id
  room          VisualisationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  jobId         String            @unique
  job           VisualisationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  publishedById String
  publishedAt   DateTime          @default(now())
}

model VisualisationAudit {
  id          String   @id @default(uuid())
  actorId     String
  apartmentId String
  jobId       String
  action      String
  createdAt   DateTime @default(now())
}

// No job FK: deleting an apartment must not refund accepted provider requests.
model VisualisationUsage {
  jobId      String    @id
  companyId  String
  kind       String
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId, kind, createdAt])
}

// The only active publication for an apartment, independent of legacy room data.
model ApartmentVisualisationPublication {
  apartmentId   String           @id
  apartment     Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  jobId         String           @unique
  job           VisualisationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  publishedById String
  publishedAt   DateTime         @default(now())
}
