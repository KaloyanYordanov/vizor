DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vizor
SESSION_SECRET=replace-with-a-long-random-secret
# Set only if requests reach Remix through a proxy with a different internal origin.
# APP_ORIGIN=https://vizor.example.com

# Required for image generation. Server-only.
OPENAI_API_KEY=
VISUALISATIONS_ENABLED=true
VISUALISATIONS_PUBLIC_ENABLED=true
VISUALISATION_IMAGE_MODEL=gpt-image-2.5-sunburst
# Small default. Supported: 1024x1024, 1536x1024, 1024x1536
VISUALISATION_IMAGE_SIZE=1024x1024
# Supported: low, medium, high
VISUALISATION_IMAGE_QUALITY=medium
VISUALISATION_DAILY_IMAGE_LIMIT=20
VISUALISATION_CONCURRENCY=2
VISUALISATION_TIMEOUT_SECONDS=240
# Production: shared persistent PRIVATE volume mounted in both web and worker.
VISUALISATION_STORAGE_DIR=.data/visualisations
